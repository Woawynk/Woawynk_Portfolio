# ================================================================
# CẤU HÌNH KẾT NỐI SUPABASE CHO PORTFOLIO (HUỲNH THÁI HOÀ)
# Chỉ cần duy nhất 1 biến môi trường: DATABASE_URL
# ================================================================
# Lấy URL này trong Supabase: Project Settings -> Database -> Connection string (URI)
# Chế độ: Direct connection (Port 5432) hoặc Connection Pooling (Port 6543)
#
# Ví dụ:
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# hoặc
# DATABASE_URL=postgresql://postgres:yourpassword@db.yourprojectref.supabase.co:5432/postgres

DATABASE_URL=
PORT=3000
